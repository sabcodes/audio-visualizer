{
  "name": "desktop-music-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test --project=compatibility --project=unsupported",
    "test:browser:ogre": "playwright test tests/browser/giant.spec.ts --project=compatibility --project=ogre-webgpu",
    "test:browser:hardware": "playwright test --project=hardware-webgpu",
    "test:release": "playwright test --config=playwright.stage5.config.ts",
    "test:release:static": "STAGE5_STATIC=1 playwright test --config=playwright.stage5.config.ts",
    "test:release:soak": "STAGE5_SOAK=1 playwright test --config=playwright.stage5.config.ts --grep @soak",
    "bench": "playwright test --project=benchmark",
    "security:staged": "python3 -B scripts/security_scan.py check-staged",
    "security:scan": "python3 -B scripts/security_scan.py scan-repo",
    "security:history": "python3 -B scripts/security_scan.py check-history",
    "security:install": "python3 -B scripts/security_scan.py install",
    "test:security": "python3 -B tests/security_gate_test.py"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
